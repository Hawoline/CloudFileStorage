### 1. Получаем CSRF токен и сохраняем его
### 1. Безопасное получение CSRF токена
GET http://localhost:8080/auth/csrf
Accept: application/json

> {%
    var token = null;

    if (response.body && response.body.token) {
        token = response.body.token;
        client.log("Токен взят из JSON тела.");
    }
    else if (response.headers.valueOf("X-XSRF-TOKEN")) {
        token = response.headers.valueOf("X-XSRF-TOKEN");
        client.log("Токен взят из заголовка X-XSRF-TOKEN.");
    }

    // 3. Сохраняем, если нашли
    if (token) {
        client.global.set("csrf_token", token);
        client.log("CSRF Токен успешно сохранен: " + token);
    } else {
        client.log("ОШИБКА: Сервер не вернул токен ни в JSON, ни в заголовках!");
        client.log("Статус ответа сервера: " + response.status);
        client.log("Тело ответа: " + JSON.stringify(response.body));
    }
%}
###
GET http://localhost:8080/auth/logout
X-XSRF-TOKEN: {{csrf_token}}

###
POST http://localhost:8080/auth/sign-up
Content-Type: application/json
X-XSRF-TOKEN: {{csrf_token}}

{
  "username": "Beliktos",
  "password": "Beliktos2001"
}


### 2. Выполняем логин с использованием полученного токена
POST http://localhost:8080/auth/login
Content-Type: application/json
# Подставляем сохраненный токен в нужный заголовок
X-XSRF-TOKEN: {{csrf_token}}

{
  "username": "Hawoline",
  "password": "Hawoline2001"
}

###
GET http://localhost:8080/user/me
X-XSRF-TOKEN: {{csrf_token}}
